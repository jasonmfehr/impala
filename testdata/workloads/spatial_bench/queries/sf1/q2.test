====
---- QUERY
SELECT COUNT(*) AS trip_count_in_coconino_county
FROM trip t
WHERE ST_Intersects(
    ST_GeomFromWKB(CAST(t.t_pickuploc AS BINARY)),
    (SELECT ST_GeomFromWKB(CAST(z.z_boundary AS BINARY)) FROM zone z WHERE z.z_name = 'Coconino County' LIMIT 1)
);
---- TYPES
BIGINT
---- RESULTS
541
====
