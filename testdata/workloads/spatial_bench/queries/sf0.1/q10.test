====
---- QUERY
SET COMPUTE_PROCESSING_COST=True;
SET SLOT_COUNT_STRATEGY=PLANNER_CPU_ASK;
SET MT_DOP=28;
-- Spatial Bench Q10 SF0.1
SELECT
    z.z_zonekey,
    z.z_name AS pickup_zone,
    AVG(UNIX_TIMESTAMP(t.t_dropofftime) - UNIX_TIMESTAMP(t.t_pickuptime)) AS avg_duration,
    AVG(t.t_distance) AS avg_distance,
    COUNT(t.t_tripkey) AS num_trips
FROM
    zone z
    LEFT JOIN trip t
    ON ST_Within(
        ST_GeomFromWKB(CAST(t.t_pickuploc AS BINARY)), ST_GeomFromWKB(CAST(z.z_boundary AS BINARY))
    )
GROUP BY z.z_zonekey, z.z_name
ORDER BY avg_duration DESC NULLS LAST, z.z_zonekey ASC
LIMIT 100;
---- TYPES
BIGINT,VARCHAR,DOUBLE,DOUBLE,BIGINT
