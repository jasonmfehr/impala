====
---- QUERY
SET COMPUTE_PROCESSING_COST=True;
SET SLOT_COUNT_STRATEGY=PLANNER_CPU_ASK;
SET MT_DOP=28;
-- Spatial Bench Q6 SF0.1
SELECT
    z.z_zonekey,
    z.z_name,
    COUNT(t.t_tripkey) AS total_pickups,
    AVG(t.t_distance) AS avg_distance,
    AVG(UNIX_TIMESTAMP(t.t_dropofftime) - UNIX_TIMESTAMP(t.t_pickuptime)) AS avg_duration
FROM trip t, zone z
WHERE ST_Intersects(
    ST_GeomFromText('POLYGON((-112.2110 34.4197, -111.3110 34.4197, -111.3110 35.3197, -112.2110 35.3197, -112.2110 34.4197))'),
    ST_GeomFromWKB(CAST(z.z_boundary AS BINARY))
  )
  AND ST_Within(
    ST_GeomFromWKB(CAST(t.t_pickuploc AS BINARY)),
    ST_GeomFromWKB(CAST(z.z_boundary AS BINARY))
  )
GROUP BY z.z_zonekey, z.z_name
ORDER BY total_pickups DESC, z.z_zonekey ASC;
---- TYPES
BIGINT,VARCHAR,BIGINT,DECIMAL,DOUBLE
---- RESULTS
149106,'Coconino County',45,0.000025,5416.955555555555
132418,'Yavapai County',32,0.000035,7245.1875
82996,'Gila County',3,0.000010,2404.666666666667
