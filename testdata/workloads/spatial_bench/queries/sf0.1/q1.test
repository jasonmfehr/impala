====
---- QUERY
SET COMPUTE_PROCESSING_COST=True;
SET SLOT_COUNT_STRATEGY=PLANNER_CPU_ASK;
SET MT_DOP=28;
-- Spatial Bench Q1 SF0.1
SELECT
    t.t_tripkey,
    -- A point's coordinates are identical under either edge interpretation, so the lon/lat
    -- projection stays on the geometry accessor, which is the more widely available one.
    ST_X(ST_GeomFromWKB(CAST(t.t_pickuploc AS binary))) AS pickup_lon,
    ST_Y(ST_GeomFromWKB(CAST(t.t_pickuploc AS binary))) AS pickup_lat,
    t.t_pickuptime,
    ST_Distance(
        ST_GeomFromWKB(CAST(t.t_pickuploc AS binary)),
        ST_GeomFromText('POINT (-111.7610 34.8697)')
    ) AS distance_to_center -- metres
FROM trip t
WHERE ST_Distance(
    ST_GeomFromWKB(CAST(t.t_pickuploc AS binary)),
    ST_GeomFromText('POINT (-111.7610 34.8697)')
) < 0.45

ORDER BY distance_to_center ASC, t.t_tripkey ASC
LIMIT 94;
---- TYPES
BIGINT,DOUBLE,DOUBLE,TIMESTAMP,DOUBLE
