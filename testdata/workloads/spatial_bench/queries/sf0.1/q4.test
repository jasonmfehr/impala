====
---- QUERY
SET COMPUTE_PROCESSING_COST=True;
SET SLOT_COUNT_STRATEGY=PLANNER_CPU_ASK;
SET MT_DOP=28;
SET BATCH_SIZE=750;
SELECT z.z_zonekey, z.z_name, COUNT(*) AS trip_count
FROM zone z
JOIN (
    SELECT t.t_pickuploc
    FROM trip t
    ORDER BY t.t_tip DESC, t.t_tripkey ASC
    LIMIT 1000
) top_trips
ON ST_Within(
    ST_GeomFromWKB(CAST(top_trips.t_pickuploc AS BINARY)),
    ST_GeomFromWKB(CAST(z.z_boundary AS BINARY))
)
GROUP BY z.z_zonekey, z.z_name
ORDER BY trip_count DESC, z.z_zonekey ASC;
---- TYPES
BIGINT,VARCHAR,BIGINT
