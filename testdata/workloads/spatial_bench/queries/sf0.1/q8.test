====
---- QUERY
SET COMPUTE_PROCESSING_COST=True;
SET SLOT_COUNT_STRATEGY=PLANNER_CPU_ASK;
SET MT_DOP=28;
-- Spatial Bench Q8 SF0.1
SELECT b.b_buildingkey, b.b_name, COUNT(*) AS nearby_pickup_count
FROM trip t
JOIN building b
ON ST_Distance(ST_GeomFromWKB(CAST(t.t_pickuploc AS BINARY)), ST_GeomFromWKB(CAST(b.b_boundary AS BINARY))) <= 0.0045
GROUP BY b.b_buildingkey, b.b_name
ORDER BY nearby_pickup_count DESC, b.b_buildingkey ASC
LIMIT 100;
---- TYPES
BIGINT,VARCHAR,BIGINT
---- RESULTS
====
