====
---- QUERY
-- Spatial Bench Q7 SF0.1
WITH trip_lengths AS (
    SELECT
        t.t_tripkey,
        t.t_distance AS reported_distance_m,
        ST_Length(
            ST_MakeLine(
                ST_GeomFromWKB(CAST(t.t_pickuploc AS BINARY)),
                ST_GeomFromWKB(CAST(t.t_dropoffloc AS BINARY))
            )
        ) / 0.000009 AS line_distance_m
    FROM trip t
)
SELECT
    t.t_tripkey,
    t.reported_distance_m,
    t.line_distance_m,
    t.reported_distance_m / NULLIF(t.line_distance_m, 0) AS detour_ratio
FROM trip_lengths t
ORDER BY
    detour_ratio DESC NULLS LAST,
    reported_distance_m DESC,
    t_tripkey ASC
LIMIT 100;
---- TYPES
BIGINT,DOUBLE,DOUBLE,DOUBLE
