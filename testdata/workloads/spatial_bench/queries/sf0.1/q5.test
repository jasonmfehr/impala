====
---- QUERY
SELECT
    c.c_custkey,
    c.c_name AS customer_name,
    DATE_TRUNC('month', t.t_pickuptime) AS pickup_month,
    ST_Area(ST_ConvexHull(ST_GeomCollection(ST_AsText(ST_GeomFromWKB(CAST(t.t_dropoffloc AS BINARY)))))) AS monthly_travel_hull_area,
    COUNT(t.t_tripkey) AS dropoff_count
FROM trip t
JOIN customer c ON t.t_custkey = c.c_custkey
GROUP BY c.c_custkey, c.c_name, pickup_month, monthly_travel_hull_area
HAVING COUNT(t.t_tripkey) > 5
ORDER BY monthly_travel_hull_area DESC, c.c_custkey ASC, pickup_month ASC
LIMIT 100;
---- TYPES
BIGINT,VARCHAR,TIMESTAMP,DOUBLE,BIGINT
